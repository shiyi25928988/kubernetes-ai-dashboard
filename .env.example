# SERVER
SERVER_PORT=
SPRING_PROFILES_ACTIVE=dev

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/dashboard?createDatabaseIfNotExist=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# MinIO
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=mpi
MINIO_USERNAME=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_ISHTTPS=false

# AI/OpenAI 配置
SPRING_AI_OPENAI_BASE_URL=
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_CHAT_MODEL=

# Docker Registry
DOCKER_REGISTRY_URL=
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=

# Kubernetes Client 配置
# 方式1: 从 URL 下载 kubeconfig
KUBERNETES_CLIENT_CONFIG_URL=
# 方式2: 使用本地 kubeconfig 文件路径
KUBERNETES_CLIENT_CONFIG_PATH=
# 是否信任 Kubernetes API 证书
KUBERNETES_CLIENT_TRUST_CERTS=true
