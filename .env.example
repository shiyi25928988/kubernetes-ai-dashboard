# SERVER
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mpi
MYSQL_USER=mpi
MYSQL_PASSWORD=mpi123456
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/mpi?createDatabaseIfNotExist=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=mpi
SPRING_DATASOURCE_PASSWORD=mpi123456

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=redis123456

# MinIO
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=mpi
MINIO_USERNAME=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_ISHTTPS=false

# Milvus (可选，如果启用)
SPRING_AI_VECTORSTORE_MILVUS_CLIENT_HOST=
SPRING_AI_VECTORSTORE_MILVUS_CLIENT_PORT=
SPRING_AI_VECTORSTORE_MILVUS_CLIENT_DATABASE_NAME=default
SPRING_AI_VECTORSTORE_MILVUS_CLIENT_COLLECTION_NAME=vector_store

# AI/OpenAI 配置
SPRING_AI_OPENAI_BASE_URL=http://oneapi.isic.shiyi.intra
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_CHAT_MODEL=Qwen3_30B_A3B
SPRING_AI_OPENAI_EMBEDDING_MODEL=BGE_M3

# Docker Registry
DOCKER_REGISTRY_URL=http://10.113.16.240
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=

# Kubernetes Client 配置
# 方式1: 从 URL 下载 kubeconfig
KUBERNETES_CLIENT_CONFIG_URL=
# 方式2: 使用本地 kubeconfig 文件路径
KUBERNETES_CLIENT_CONFIG_PATH=
# 是否信任 Kubernetes API 证书
KUBERNETES_CLIENT_TRUST_CERTS=true
